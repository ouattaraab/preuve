<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenêtre affichée pendant le démarrage du processus, mode clair. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!--
        Fenêtre une fois le processus lancé, et fond DERRIÈRE l'interface
        Flutter. Le crème plutôt que `?android:colorBackground` : la couleur
        du système est blanche, et elle transparaissait le temps d'une image
        entre le démarrage et le premier écran.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/preuve_creme</item>
    </style>
</resources>
