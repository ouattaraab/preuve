<?xml version="1.0" encoding="utf-8"?>
<!--
    Icône adaptative (Android 8+). ELLE N'EXISTAIT PAS.

    Sans ce fichier, le lanceur traite `ic_launcher.png` comme une icône
    héritée : il la rétrécit et la pose au centre d'une pastille blanche. La
    marque apparaissait donc deux fois plus petite que ses voisines, cerclée
    d'un blanc qui n'est nulle part dans la direction DJASSA.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/preuve_encre"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
