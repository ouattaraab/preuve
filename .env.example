APP_NAME=Preuve
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.preuve.ci

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=preuve
DB_USERNAME=preuve
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Hébergement mutualisé : aucun processus résident, donc drivers base
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Documents chiffrés côté application avant envoi
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=preuve-documents
R2_ENDPOINT=https://<compte>.r2.cloudflarestorage.com

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Passerelle de messagerie. `log` est le défaut de Laravel : les messages sont
# écrits dans un fichier et NE PARTENT PAS. Une installation laissée ainsi voit
# tous ses envois « réussir » sans que rien n'arrive — éprouvez la passerelle
# avec `php artisan preuve:check-mail`, qui refuse de conclure sur `log`.
#
# Hostinger : SMTP sur smtp.hostinger.com, port 465 en SSL (`smtps`) ou 587 en
# STARTTLS (`tls`). Les identifiants sont ceux d'une boîte créée dans hPanel →
# Emails, pas ceux du compte d'hébergement.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@preuve.click
MAIL_PASSWORD=
# DOIT correspondre à une boîte réelle du domaine : une adresse d'expédition
# étrangère au domaine fait échouer SPF et DKIM, et les messages finissent en
# indésirables — ou nulle part.
MAIL_FROM_ADDRESS="no-reply@preuve.click"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sel quotidien des hashs d'IP — rotation par tâche planifiée
IP_HASH_SALT=

VITE_APP_NAME="${APP_NAME}"
